{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build MagSim project",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-I", "${workspaceFolder}/MagSim/Include",
                "${file}",
                "-L", "C:/msys64/ucrt64/lib",
                "-lraylib",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Mag-Sim project"
        }
    ],
    "version": "2.0.0"
}